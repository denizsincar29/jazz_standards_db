# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jazz
DB_PASSWORD=changeme
DB_NAME=jazz

# Server
PORT=8000
JWT_SECRET=change-this-to-a-long-random-secret

# Set to a sub-path if running behind a reverse proxy, e.g. /jazz
# Leave empty to serve from root /
BASE_PATH=

# Set to any non-empty value to enable the /testapi debug page
TEST_API=

# ntfy.sh push notifications (leave NTFY_TOPIC empty to disable)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# production | development
ENVIRONMENT=development

# Test database (only needed for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=jazz
TEST_DB_PASSWORD=jazz
TEST_DB_NAME=jazz_test
